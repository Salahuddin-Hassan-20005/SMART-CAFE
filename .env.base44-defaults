# Placeholders so the app boots without credentials.
# Real values come from the app's secrets (/run/base44/app.env), which is loaded
# AFTER this file and therefore always wins.
#
# Replace these with your own Firebase project values (or provide them as
# secrets) for sign-in, orders and menu data to work.

FIREBASE_API_KEY=placeholder-firebase-api-key
FIREBASE_AUTH_DOMAIN=placeholder.firebaseapp.com
FIREBASE_PROJECT_ID=placeholder-smart-cafe
FIREBASE_STORAGE_BUCKET=placeholder-smart-cafe.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Optional: leave empty to use the "(default)" Firestore database.
FIREBASE_FIRESTORE_DATABASE_ID=

# AI concierge (Groq). Placeholder keeps the UI unlocked; real key needed for AI replies.
GROQ_API_KEY=placeholder-groq-api-key
